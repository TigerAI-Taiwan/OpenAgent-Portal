# Copy to .env, then fill in the administrator below. Never commit .env.

# --- First administrator (read on the very first start only) ---------------
# This is the customer's own administrator; pick any email, a single-label one such as adm@local is fine.
# If the password is left empty a one-time password is printed once in `docker compose logs pi-web`.
# Either way the administrator must choose a new password at the first login.
TIGERAI_ADMIN_EMAIL=adm@local
TIGERAI_ADMIN_PASSWORD=change-me-to-a-long-password

# --- TigerAI maintenance account (optional; leave empty for none) ----------------
# Can see system status, model connections and service settings only. It cannot read anyone's
# conversations or records, and the administrator can disable it at any time.
TIGERAI_VENDOR_EMAIL=
TIGERAI_VENDOR_PASSWORD=
TIGERAI_VENDOR_MUST_CHANGE=1

# --- Network ----------------------------------------------------------------
# Host-side port (the container listens on 30161).
PI_WEB_PORT=30161
# 127.0.0.1 = this machine only. Use 0.0.0.0 to reach it from the LAN, and then list the
# hostnames people type in the browser (comma separated, exact) in PI_WEB_ALLOWED_HOSTS.
PI_WEB_BIND=127.0.0.1
PI_WEB_ALLOWED_HOSTS=
# Set to 1 only when the Portal is served over HTTPS.
TIGERAI_COOKIE_SECURE=

# --- Optional services (docker compose profiles; leave COMPOSE_PROFILES empty to start the Portal alone) ---
# search = SearXNG (web search), convert = Gotenberg (PDF for slides and forms), n8n = n8n (workflows).
#   COMPOSE_PROFILES=search,convert,n8n
COMPOSE_PROFILES=
# Fill in a random string (e.g. `openssl rand -hex 32`) before starting the search profile.
SEARXNG_SECRET=
# Same for n8n: a random string you keep; n8n encrypts its saved credentials with it.
N8N_ENCRYPTION_KEY=
# The n8n editor listens on this machine only; N8N_BIND=0.0.0.0 shares it with the LAN.
N8N_BIND=127.0.0.1
N8N_PORT=5678

# --- Time zone: schedules (daily summary at 18:00, overdue days) use it ------
TZ=Asia/Taipei

# --- Upstream pi-web only ----------------------------------------------------
# Leave empty. Only used when you remove TIGERAI_ENABLED from compose.yaml.
PI_WEB_PASSWORD=

# --- Workspace folder bind-mounted into the container ------------------------
WORKSPACE_DIR=./workspace
WORKSPACE_CONTAINER_DIR=/workspace
